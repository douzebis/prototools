# Set up the demo workspace. Sourced by teleprompt at startup unless
# --no-init.
#
# Removing what a previous run generated (capture/, life.desc, life/,
# eve/server.log) is not done here: it is the deck's first step, so the
# presenter can skip it and keep those artifacts (spec 0399).

_init_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Spec 0399 S3: when the teleprompt quits, stop the tap the deck started.
# The deck runs from here, so its `life-tap -q` writes to ./capture. The
# pid-file test keeps a session that started no tap quiet.
printf -v _capture '%q' "${_init_dir}/capture"
teleprompt_at_exit "[ -e ${_capture}/tap.pid ] && life-tap --out ${_capture} --stop"
unset _capture

# Alice's copy of the client binary, for protoscan and reproto (spec 0388
# S3). On a Nix PATH, life-client is a wrapper script; the binary, with its
# embedded descriptors, is the .life-client-wrapped beside it.
_client="$(readlink -f "$(command -v life-client)")"
_wrapped="$(dirname "${_client}")/.life-client-wrapped"
[ -e "${_wrapped}" ] && _client="${_wrapped}"
rm -f "${_init_dir}/life-client"
cp "${_client}" "${_init_dir}/life-client"
chmod u+w "${_init_dir}/life-client"
# The waiting screen, up while the audience settles: the S3NS logo alone,
# filling the screen, until Enter. chafa draws the SVG itself; s3ns.svg
# carries explicit width and height for it, without which its loader draws
# the logo clipped. One row is left for the cursor.
clear
chafa --align mid,mid -s "$(tput cols)x$(( $(tput lines) - 1 ))" \
    "${_init_dir}/images/s3ns.svg"
read -rs _ </dev/tty
clear
unset _init_dir _client _wrapped

header "prototools"

echo "
            [1;94mGreHack 2026


            Dissecting protobuf:
            Schema recovery, covert channels, and what your decoder
            quietly throws away


            A live demo of prototools
            https://github.com/ThalesGroup/prototools


            Frédéric RUGET
            fred@s3ns.io

[0m


"

# The title slide stays up until Enter too; then the deck starts on a clean
# screen.
read -rs _ </dev/tty
clear
